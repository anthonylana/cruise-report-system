#!/usr/bin/env bash
# Runs the same checks as CI before every push.
# Bypass in an emergency with: git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

echo "▶ Backend: pytest"
cd "$ROOT/backend"
if [ -f .venv/Scripts/python.exe ]; then
  PY=".venv/Scripts/python.exe"   # Windows venv
elif [ -f .venv/bin/python ]; then
  PY=".venv/bin/python"           # Linux/macOS venv
else
  echo "✖ backend/.venv not found. Create it first (see README)."
  exit 1
fi
"$PY" -m pytest -q

echo "▶ Frontend: lint, format, type-check"
cd "$ROOT/frontend"
npm run lint --silent
npm run format:check --silent
echo "==> Frontend tests"
npm test
npx tsc -b

echo "✔ All checks passed, pushing."
